#!/usr/bin/env bash
# Gate for every change: build, vet, staticcheck, test. Zero warnings.
#
# The race detector turns on checkptr, which rejects the uintptr arithmetic in
# fiatjaf.com/nostr's JSON hashing (event.go writeJSONString). Those reads stay in
# bounds, so checkptr is disabled for that module only; our own packages keep it.
set -euo pipefail
cd "$(dirname "$0")/.."
go build ./...
go vet ./...
go tool staticcheck ./...
go test -race -gcflags='fiatjaf.com/nostr=-d=checkptr=0' ./...
